{
  "name": "markethub-ai",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite",
    "preview": "vite preview --host 0.0.0.0",
    "check:continuity": "node scripts/check-continuity.mjs",
    "android:init": "npx cap add android",
    "ios:init": "npx cap add ios",
    "mobile:sync": "npm run build && npx cap sync",
    "android:open": "npm run mobile:sync && npx cap open android",
    "ios:open": "npm run mobile:sync && npx cap open ios",
    "test:office": "node --test tests/office.test.mjs",
    "test": "npm run check:continuity && node --test tests/*.test.mjs && npm run check:pages",
    "test:visual": "node --test tests/visual.test.mjs",
    "test:growth": "node --test tests/growth.test.mjs",
    "test:backup": "node --test tests/backup.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "check:pages": "node scripts/check-github-pages.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "vite": "^8.3.5"
  }
}
