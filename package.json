{
  "name": "markethub-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite",
    "preview": "vite preview --host 0.0.0.0",
    "android:init": "npx cap add android",
    "ios:init": "npx cap add ios",
    "mobile:sync": "npm run build && npx cap sync",
    "android:open": "npm run mobile:sync && npx cap open android",
    "ios:open": "npm run mobile:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "vite": "^8.3.5"
  }
}
